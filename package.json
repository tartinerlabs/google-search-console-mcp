{
  "name": "@tartinerlabs/webmaster-mcp",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "check": "pnpm lint && turbo run typecheck test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "semantic-release": "25.0.9",
    "turbo": "2.11.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.8.2",
      "onFail": "download"
    }
  }
}
