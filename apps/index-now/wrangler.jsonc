// Read by Cloudflare Workers Builds (git deployment) only; nothing runs Wrangler locally.
{
  "name": "index-now-mcp",
  "main": "src/index.ts",
  // nodejs_compat (on by default from 2026-08-04) populates process.env from vars and secrets.
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // @repo/core is consumed from its compiled dist/, so build it before the Worker is bundled.
  "build": { "command": "pnpm --filter @repo/core build" },
  "observability": { "enabled": true },
  // Non-production branch builds run `wrangler preview`, which requires this block.
  // Previews get no Workflow binding, so submit_urls only works in production.
  "previews": {},
  // submit_urls runs each submission as a durable Workflow instance that
  // retries while the key file goes live and when IndexNow rate-limits.
  "workflows": [
    {
      "name": "index-now-submissions",
      "binding": "SUBMISSIONS",
      "class_name": "SubmitWorkflow"
    }
  ]
}
