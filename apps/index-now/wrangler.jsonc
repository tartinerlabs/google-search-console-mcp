// Read by Cloudflare Workers Builds (git deployment) only; nothing runs Wrangler locally.
{
  "name": "index-now-mcp",
  "main": "src/index.ts",
  // nodejs_compat (on by default from 2026-08-04) populates process.env from vars and secrets.
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // @repo/core is consumed from its compiled dist/, so build it before the Worker is bundled.
  "build": { "command": "pnpm --filter @repo/core build" },
  "observability": { "enabled": true },
  // submit_urls queues submissions; the consumer merges them per host and backs
  // off when IndexNow answers 429. The queue must exist in the account first.
  "queues": {
    "producers": [
      { "binding": "INDEXNOW_QUEUE", "queue": "index-now-submissions" }
    ],
    "consumers": [
      {
        "queue": "index-now-submissions",
        "max_batch_size": 100,
        "max_batch_timeout": 30,
        "max_retries": 5
      }
    ]
  }
}
